rules_version = '2';

// Security model: there is no user auth. Access is gated by knowledge of the
// short camp code (the document ID under /camps). Anyone who has the code
// (shared verbally/via text among camp staff) can read and write that camp's
// data - this trades strict access control for zero-friction shared editing
// across many devices, which is the intended use case for a small camp.
//
// The one thing we actively prevent is *discovering* camp codes: `list` is
// blocked on the camps collection so codes can't be enumerated, only looked
// up by exact ID (`get`), which the app does when someone types in a code.
service cloud.firestore {
  match /databases/{database}/documents {
    match /camps/{campId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().hasAll(['name', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 200;
      // Only the double-point-day list and the scorekeeper pin may change
      // after creation.
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['doublePointDays', 'pin']);
      allow delete: if false;

      match /teams/{teamId} {
        allow read, write: if true;
      }
      match /eventPresets/{presetId} {
        allow read, write: if true;
      }
      match /schedule/{itemId} {
        allow read, write: if true;
      }
      match /transactions/{txId} {
        allow read, create, delete: if true;
        allow update: if false;
      }
    }
  }
}
