# Copy this file to `.env` and fill in the values from your Firebase project
# (Project settings → General → Your apps → SDK setup and configuration).
# Without these, the app runs against a throwaway demo project and nothing saves.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: point the app at a local Firestore emulator during development.
# VITE_USE_FIRESTORE_EMULATOR=true
